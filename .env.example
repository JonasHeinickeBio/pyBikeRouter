# OpenRouteService
ORS_API_KEY=changeme
ORS_BASE_URL=https://api.openrouteservice.org
ORS_TIMEOUT_S=10.0
ORS_MAX_RETRIES=2
# Self-hosted stack (docs/self-hosted.md; run just one half on a small machine with
# scripts/self-hosted-bootstrap.sh --only routing|geocoding): ORS_BASE_URL=http://127.0.0.1:8080/ors,
# ORS_API_KEY may stay empty, and GEOCODER_BASE_URL=http://127.0.0.1:8081 below.

# Geocoding
# GEOCODER_PROVIDER: nominatim (default, works with the public ORS) or
# pelias (requires a self-hosted openrouteservice; the public API does not
# serve Pelias and startup fails fast when the two are combined).
GEOCODER_PROVIDER=nominatim
GEOCODER_BASE_URL=https://nominatim.openstreetmap.org
GEOCODER_TIMEOUT_S=5.0
GEOCODER_USER_AGENT=bike-routing-agent/0.1 (contact: you@example.com)
GEOCODER_CACHE_TTL_S=3600
GEOCODER_AMBIGUITY_MARGIN=0.05
GEOCODER_MIN_CONFIDENCE=0.3

# Candidates whose routes stay within this many metres (discrete Frechet
# distance) are treated as one alternative (see docs/api.md, "Alternatives").
ALTERNATIVE_DEDUP_THRESHOLD_M=50

# Artifact storage / retention (docs/persistence.md). S3 credentials come from
# boto3's usual chain (AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY), not from here.
# ARTIFACT_BACKEND=s3
# S3_BUCKET=bike-exports
# S3_ENDPOINT_URL=http://127.0.0.1:8333   # compose `s3` profile (dev only)
# S3_PATH_STYLE=true
# RETENTION_MAX_AGE_DAYS=90      # applied by `bike-router retention prune --execute`

# /readyz probes: per-probe timeout, result reuse, and a longer reuse for the
# geocoder (the default one is the public Nominatim). See docs/api.md.
HEALTH_PROBE_TIMEOUT_S=5
HEALTH_CACHE_TTL_S=30
HEALTH_GEOCODER_CACHE_TTL_S=300

# Routing engine selection
# ROUTING_PROVIDER: ors (default, public or self-hosted openrouteservice),
# brouter (local/self-hosted BRouter RouteServer; start it with
# `docker compose -f docker/compose.yaml --profile brouter up`, see
# docker/brouter/README.md), valhalla (local/self-hosted Valhalla service;
# start it with `docker compose -f docker/compose.yaml --profile valhalla up`),
# or all (queries ors + brouter + valhalla in parallel and scores the
# candidates; every configured engine must be reachable).
# No automatic fallback between engines.
ROUTING_PROVIDER=ors
BROUTER_BASE_URL=http://127.0.0.1:17777
BROUTER_TIMEOUT_S=30.0
BROUTER_MAX_RETRIES=1

# Valhalla routing engine
VALHALLA_BASE_URL=http://localhost:8002
VALHALLA_TIMEOUT_S=30.0
VALHALLA_MAX_RETRIES=1

# Local artifact storage
EXPORT_DIR=exports

# Logging
LOG_LEVEL=INFO

# Persistence (issue #7): route history in PostgreSQL + PostGIS. Unset (the
# default) keeps the service stateless. Start a local one with
# `docker compose -f docker/compose.yaml --profile postgis up` and install
# the extra: `poetry install --extras db`.
# DATABASE_URL=postgresql://bikerouter:bikerouter@127.0.0.1:5432/bikerouter
# DATABASE_POOL_MAX_SIZE=5
# Schema migrations (docs/persistence.md): the first database use applies pending
# ones. Set false to migrate in a release step with `bike-router db migrate`.
# AUTO_MIGRATE=true
# ARTIFACT_BACKEND: local (default, files under EXPORT_DIR) or database
# (exports stored in PostgreSQL so several API instances can share them).
# ARTIFACT_BACKEND=local
