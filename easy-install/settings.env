# Settings for pyBikeRouter. Lines starting with # are ignored. You can leave this as it is.
# After a change, run the Stop script and then the Start script again.

# The address is http://localhost:PORT -- change PORT if 8000 is used by another program.
PORT=8000

# 127.0.0.1 = only this computer can open the page.
# 0.0.0.0   = other devices on your home network can open it too (http://<this computer>:PORT).
APP_BIND=127.0.0.1

# Optional: an openrouteservice key (free at openrouteservice.org) adds a second routing engine.
# ORS_API_KEY=

# Optional: your e-mail address, so the free place-search service can reach you if needed.
# GEOCODER_USER_AGENT=pyBikeRouter you@example.com
